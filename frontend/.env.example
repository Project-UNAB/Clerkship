# Firebase — solo para el Módulo de Desarrollo (Cuestionario/Cronograma/Repositorio).
# Copia este archivo a ".env" y pega los valores reales que te da la consola de
# Firebase (Configuración del proyecto > Tus apps > Config del SDK).
# No es información secreta (es la config pública del cliente web de Firebase),
# pero igual .env está en .gitignore para no ensuciar el repo con configuración de entorno.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend real (Flask + Supabase) — login principal /login y /register.
VITE_API_BASE_URL=http://localhost:5000

# Backend de simulación clínica (backend/flask-api — Agentes IA / Consultas /
# Historial). Corre APARTE del backend de arriba, en su propio puerto, pero
# usa el mismo access_token (comparten JWT_SECRET_KEY y la misma Supabase/Mongo).
VITE_SIMULACION_API_BASE_URL=http://localhost:5001
