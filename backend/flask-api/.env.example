# --- Base de Datos PostgreSQL ---
# Remoto (Supabase):
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres
# Local (Docker):
# DATABASE_URL=postgresql+psycopg2://postgres_admin:postgres_password@localhost:5432/medical_simulator

# --- Base de Datos MongoDB ---
# Remoto (MongoDB Atlas):
MONGODB_URI=mongodb+srv://usuario:PASSWORD@clase.qm36lkz.mongodb.net/clerkship?retryWrites=true&w=majority&appName=clase
MONGODB_DB_NAME=clerkship
# Local (Docker):
# MONGODB_URI=mongodb://admin_username:admin_password@localhost:27017/medical_simulator?authSource=admin
# MONGODB_DB_NAME=medical_simulator

JWT_SECRET_KEY=change-this-to-a-long-random-string

JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

CORS_ORIGINS=http://localhost:5173

FLASK_ENV=development

# Verificación de correo por Mailgun (registro/login). Si se dejan vacías,
# el código de verificación NO se manda por correo de verdad — queda en modo
# simulado: se imprime en la consola del backend (ver app/mailer.py).
# clerk-ship.online ya está verificado en Mailgun (SPF/DKIM/DMARC vía DNS de
# GoDaddy) — completar con el API key real de la cuenta de Mailgun.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=clerk-ship.online
MAILGUN_FROM=Clerkship <verificacion@clerk-ship.online>

# --- Inteligencia Artificial (ClinicAI UNAB) — un único proveedor: Google Gemini ---
# Opciones para AI_AGENT_PROVIDER:
# - 'gemini': Google Gemini para los 3 agentes (Generador de Casos, Paciente Virtual, Tutor Evaluador)
# - 'mock': Simulación determinista local sin consumir la API (sin necesitar GEMINI_API_KEY)
AI_AGENT_PROVIDER=gemini

# Gratis, sin tarjeta: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Respaldo opcional cuando Gemini esta saturado (503/429): OpenRouter con modelos gratis.
# Key en https://openrouter.ai/keys — lista de modelos separada por coma, se prueban en orden.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free

# Espejo opcional hacia el Supabase del repo original (jrojas710/proyectodegrado2).
# Replica casos_generados/sesiones_evaluadas alla ademas de en nuestra propia base
# (best-effort, nunca bloquea el flujo si falla o esta vacio). Requiere que ese
# proyecto ya tenga esas tablas creadas (ver docs/BASE_DE_DATOS.md del repo).
SUPABASE_EXTERNO_URL=
SUPABASE_EXTERNO_KEY=
